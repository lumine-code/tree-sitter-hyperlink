      "injection-regex": "^hyperlink$",
      "highlights": ["queries/highlights.scm"]
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "A Tree-sitter grammar for URLs in prose.",
    "authors": [
      {
        "name": "lumine-code"
      }
    ],
    "links": {
      "repository": "https://github.com/lumine-code/tree-sitter-hyperlink"
    }
  },
  "bindings": {
    "node": true,
    "c": true,
    "go": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
