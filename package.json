{
  "name": "@lumine-code/tree-sitter-hyperlink",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "A Tree-sitter grammar for URLs in prose.",
  "main": "bindings/node",
  "types": "bindings/node",
  "repository": "https://github.com/lumine-code/tree-sitter-hyperlink",
  "bugs": "https://github.com/lumine-code/tree-sitter-hyperlink/issues",
  "homepage": "https://github.com/lumine-code/tree-sitter-hyperlink",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0",
  "keywords": [
    "tree-sitter",
    "hyperlink",
    "url",
    "uri",
    "prose",
    "grammar",
    "parser"
  ],
  "files": [
    "*.wasm",
    "bindings/node",
    "grammar.js",
    "queries",
    "src",
    "tree-sitter.json",
    "binding.gyp"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.11"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tree-sitter generate && node-gyp rebuild",
    "build:wasm": "tree-sitter build --wasm",
    "generate": "tree-sitter generate",
    "install": "node-gyp-build",
    "test": "node --test bindings/node/binding_test.js && tree-sitter test"
  }
}
